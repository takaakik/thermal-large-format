[Unit]
Description=Thermal Large Format Camera
After=graphical.target cups.service
Wants=graphical.target

[Service]
Type=simple
User=tak
Group=tak
WorkingDirectory=/home/tak/thermal-large-format
Environment="PATH=/home/tak/thermal-large-format/venv/bin:/usr/bin:/bin"
Environment="DISPLAY=:0"
ExecStart=/home/tak/thermal-large-format/venv/bin/python -u /home/tak/thermal-large-format/thermal_camera.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
